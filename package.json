{
  "name": "side-query-extension",
  "version": "0.2.0",
  "description": "Lightweight, on-demand side conversations for Pi-Bolt.",
  "author": "Ansh Raj (Ansh99999)",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-bolt",
    "pi-extension",
    "btw"
  ],
  "files": [
    "index.mjs",
    "dist/",
    "README.md",
    "LICENSE",
    "docs/",
    "patches/",
    "scripts/"
  ],
  "pi": {
    "extensions": [
      "./index.mjs"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "benchmark": "node scripts/benchmark.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "typebox": "*",
    "@earendil-works/pi-agent-core": ">=1.4.0",
    "@earendil-works/pi-ai": ">=1.4.0",
    "@earendil-works/pi-coding-agent": ">=1.4.0",
    "@earendil-works/pi-tui": ">=1.4.0"
  },
  "peerDependenciesMeta": {
    "typebox": {
      "optional": true
    },
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ansh99999/side-query-extension.git"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
